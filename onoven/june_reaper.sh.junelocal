#!/system/bin/sh

# Copyright 2017 June Life, Inc.
#
# All rights reserved
#

# On a reboot we need to remove update.zip file from the cache directory.
# That file existing could cause ota to fail.
#
# June Local note: this is the stock june_reaper.sh with one addition. The
# collector EncFS volume is mounted read-write (instead of read-only) when a
# staged JuneCloudMessaging patch is present, the patch is applied during that
# very first mount (the same mount the stock script performs), and the mounted
# view is left read-write. Doing it here means the patch is in place before
# Android starts, instead of relying on a second EncFS mount of the same
# volume later in boot, which cannot work while /system (holding the
# ciphertext) is read-only.
#
# June Local also installs the pre-seeded June account row here, before Android
# starts: a factory reset wipes /data/system/users/0/accounts.db, and without
# that AccountManager row the June apps never attach a bearer token to the
# messaging socket (the oven looks "disconnected" even though the install is
# fine).  The seed and token come from /system/etc/june/identity and the step is
# idempotent and best-effort.

LOG_TAG="junebucket"
LOG_NAME="${0}:"


loge ()
{
  /system/bin/log -t $LOG_TAG -p e "$LOG_NAME $@"
}

logi ()
{
  /system/bin/log -t $LOG_TAG -p i "$LOG_NAME $@"
}

# --- June Local: per-oven June account/identity ----------------------------
# The June apps read one Android AccountManager row from
# /data/system/users/0/accounts.db (type com.junelife.user, authtoken type
# "Full access").  A factory reset wipes it, which drops the JCM's bearer token
# and leaves the oven "disconnected" even when the install is correct.  The
# installer ships a per-oven seed DB and token in /system; the ensure below
# runs BEFORE Android starts and installs the seed when the row is missing.
# It is idempotent and must never fail the boot: every error path only logs.
ID_DIR="/system/etc/june/identity"
ID_SEED="$ID_DIR/accounts_seed.db"
ID_TOKEN_FILE="$ID_DIR/token"
ID_JSON_SEED="$ID_DIR/identity.json"
ID_ACCOUNTS_DB="/data/system/users/0/accounts.db"
ID_LOG="/data/june/logs/identity.log"
ID_MARKER="/data/june/identity_ensure.state"

identity_log ()
{
   /system/bin/busybox mkdir -p /data/june/logs 2>/dev/null
   ID_STAMP=`/system/bin/busybox date 2>/dev/null`
   echo "${ID_STAMP:-unknown} $*" >> "$ID_LOG" 2>/dev/null
   /system/bin/busybox chmod 0644 "$ID_LOG" 2>/dev/null
   logi "june-local identity: $*"
}

identity_marker ()
{
   /system/bin/busybox mkdir -p /data/june 2>/dev/null
   echo "$1" > "$ID_MARKER" 2>/dev/null
   /system/bin/busybox chmod 0644 "$ID_MARKER" 2>/dev/null
}

identity_ensure_record ()
{
   # /data/june/identity.json is bookkeeping for june-local/the status page, not
   # the gate; restore it from the /system copy after a reset removed it.  0600:
   # it contains the full v2: token, which only root programs read.
   [ -f "$ID_JSON_SEED" ] || return 0
   [ -f /data/june/identity.json ] && return 0
   /system/bin/busybox mkdir -p /data/june 2>/dev/null
   if cp -f "$ID_JSON_SEED" /data/june/identity.json 2>/dev/null; then
      /system/bin/busybox chmod 0600 /data/june/identity.json 2>/dev/null
      identity_log "restored /data/june/identity.json from /system"
   fi
   return 0
}

identity_set_token_prop ()
{
   # Only the optional JCM token-fallback patch reads june.local.token; the
   # stock JCM and the primary AccountManager path do not.
   if [ ! -f /system/etc/june/jcm_nopin.apk ] && [ ! -f /data/june/jcm_nopin.apk ]; then
      return 0
   fi
   [ -f "$ID_TOKEN_FILE" ] || return 0
   ID_TOK=`cat "$ID_TOKEN_FILE" 2>/dev/null`
   case "$ID_TOK" in
      v2:*) setprop june.local.token "$ID_TOK" 2>/dev/null \
              && identity_log "setprop june.local.token for the JCM fallback patch" ;;
   esac
   return 0
}

ensure_june_identity ()
{
   mount -o rw,remount /data 2>/dev/null
   if [ ! -f "$ID_SEED" ]; then
      identity_log "skipped: no pre-seeded account DB at $ID_SEED"
      identity_marker "skipped-no-seed"
      return 0
   fi
   /system/bin/busybox mkdir -p /data/system/users/0 2>/dev/null
   if [ -f "$ID_ACCOUNTS_DB" ]; then
      if /system/bin/busybox grep -aq 'com\.junelife\.user' "$ID_ACCOUNTS_DB" 2>/dev/null; then
         identity_log "present: June account row found in $ID_ACCOUNTS_DB (left untouched)"
         identity_marker "present"
         identity_ensure_record
         identity_set_token_prop
         return 0
      fi
      if [ ! -f "${ID_ACCOUNTS_DB}.pre-june" ]; then
         if cp -f "$ID_ACCOUNTS_DB" "${ID_ACCOUNTS_DB}.pre-june" 2>/dev/null; then
            /system/bin/busybox chmod 0600 "${ID_ACCOUNTS_DB}.pre-june" 2>/dev/null
            identity_log "backed up the non-June accounts DB to ${ID_ACCOUNTS_DB}.pre-june"
         else
            identity_log "warning: could not back up the non-June accounts DB; installing the seed anyway"
         fi
      fi
   fi
   if ! cp -f "$ID_SEED" "$ID_ACCOUNTS_DB" 2>/dev/null; then
      identity_log "failed: could not copy the seed to $ID_ACCOUNTS_DB; leaving /data as-is"
      identity_marker "failed-copy"
      return 0
   fi
   /system/bin/busybox chown 1000:1000 "$ID_ACCOUNTS_DB" 2>/dev/null
   /system/bin/busybox chmod 0600 "$ID_ACCOUNTS_DB" 2>/dev/null
   rm -f "${ID_ACCOUNTS_DB}-journal" "${ID_ACCOUNTS_DB}-wal" "${ID_ACCOUNTS_DB}-shm" 2>/dev/null
   sync
   identity_log "created: installed the June account seed at $ID_ACCOUNTS_DB (1000:1000, 0600, journal cleared)"
   identity_marker "created"
   identity_ensure_record
   identity_set_token_prop
   return 0
}

REAPERPASSFLAG="/cache/reaperpass.flag"

# We are done
if [ -f $REAPERPASSFLAG ]; then
   rm -rf $REAPERPASSFLAG
fi

DATA_PART="/dev/block/platform/sdhci-tegra.3/by-name/UDA"
busybox df -h $DATA_PART
MNTDATA=$?

if [ "a$MNTDATA" != "a0" ]; then
  logi "Data partition isn't mounted, aborting further data work"
  setprop ro.june_encfs 1
  exit 1
fi

# --- June Local: make sure a June account row exists for this boot ----------
# Runs before Android's AccountManagerService reads accounts.db.  Never fails
# the boot: a missing/broken seed only logs.
ensure_june_identity

if [ "$(ls -a /system/priv-app)" ]; then
    mount -o rw,remount /system
    rm -rf /system/priv-app/*
    mount -o  r,remount /system
fi

if [ "$(ls -a /data/data)" ]; then
    rm -rf /data/data/*
fi

insmod /system/lib/modules/june_reaper.ko
while [ ! -f /proc/reaper ]; do sleep 2; done

RMOUNT=1
while [ "a$RMOUNT" == "a1" ]; do
   RPASS=`cat /proc/reaper`
   # Try to mount a few times, crypto chip is causing strange delays.
   echo $RPASS | /system/bin/encfs --paranoia --stdinpass --public -o sync /data/reaper /data/data
   RMOUNT=$?
done

logi "/data/data mount result ->" $RMOUNT

# Lets wait to assure we mount
/system/bin/busybox mountpoint -q /data/data
CAP=$?

while [ "a$CAP" != "a0" ]; do
    sleep 2
    /system/bin/busybox mountpoint -q /data/data
    CAP=$?
    logi "reaper mounted result ->" $CAP
done

while [ ! -f /proc/collector ]; do sleep 2; done

# --- June Local: pick the staged JCM patch, if any -------------------------
JCM_STAGE=""
if [ -f /system/etc/june/jcm_nopin.apk ]; then
   JCM_STAGE=/system/etc/june/jcm_nopin.apk
elif [ -f /data/june/jcm_nopin.apk ]; then
   JCM_STAGE=/data/june/jcm_nopin.apk
fi

# --- June Local: pick the staged Remotes (pairing UI) patch, if any --------
REMOTES_STAGE=""
if [ -f /system/etc/june/remotes_nopin.apk ]; then
   REMOTES_STAGE=/system/etc/june/remotes_nopin.apk
elif [ -f /data/june/remotes_nopin.apk ]; then
   REMOTES_STAGE=/data/june/remotes_nopin.apk
fi

# --- June Local: pick the staged MediaCapturer (cook stills) patch, if any --
MEDIACAPTURER_STAGE=""
if [ -f /system/etc/june/mediacapturer_nopin.apk ]; then
   MEDIACAPTURER_STAGE=/system/etc/june/mediacapturer_nopin.apk
elif [ -f /data/june/mediacapturer_nopin.apk ]; then
   MEDIACAPTURER_STAGE=/data/june/mediacapturer_nopin.apk
fi

# --- June Local: pick the staged Chef (cook modes) patch, if any ------------
CHEF_STAGE=""
if [ -f /system/etc/june/chef_cookmodes.apk ]; then
   CHEF_STAGE=/system/etc/june/chef_cookmodes.apk
elif [ -f /data/june/chef_cookmodes.apk ]; then
   CHEF_STAGE=/data/june/chef_cookmodes.apk
fi

ANY_STAGE=""
if [ -n "$JCM_STAGE" ]; then
   ANY_STAGE=1
fi
if [ -n "$REMOTES_STAGE" ]; then
   ANY_STAGE=1
fi
if [ -n "$MEDIACAPTURER_STAGE" ]; then
   ANY_STAGE=1
fi
if [ -n "$CHEF_STAGE" ]; then
   ANY_STAGE=1
fi

CMOUNT=1
CTRIES=0
while [ "a$CMOUNT" == "a1" ] && [ "$CTRIES" -lt 10 ]; do
   CPASS=`cat /proc/collector`

   if [ -n "$ANY_STAGE" ]; then
      # EncFS writes its ciphertext into /system/collector, so /system has to
      # be writable while the volume is mounted read-write (encfs is
      # read-write by default; the stock script only passes -o ro).
      mount -o rw,remount /system
      echo $CPASS | /system/bin/encfs --paranoia --stdinpass --public /system/collector /system/priv-app
   else
      echo $CPASS | /system/bin/encfs --paranoia --stdinpass --public -o ro /system/collector /system/priv-app
   fi
   CMOUNT=$?
   logi "/system/priv-app result ->" $CMOUNT
   CTRIES=$((CTRIES + 1))
done

# Never hang the boot on a failing read-write mount: fall back to the stock
# read-only mount, leaving the staged patch for another boot.
if [ "a$CMOUNT" == "a1" ] && [ -n "$ANY_STAGE" ]; then
   logi "june-local: read-write mount failed; falling back to stock read-only mount"
   while [ "a$CMOUNT" == "a1" ]; do
      CPASS=`cat /proc/collector`
      echo $CPASS | /system/bin/encfs --paranoia --stdinpass --public -o ro /system/collector /system/priv-app
      CMOUNT=$?
      logi "/system/priv-app result ->" $CMOUNT
   done
fi

# Lets wait to assure we mount
/system/bin/busybox mountpoint -q /system/priv-app
CAP=$?

while [ "a$CAP" != "a0" ]; do
    sleep 2
    /system/bin/busybox mountpoint -q /system/priv-app
    CAP=$?
    logi "collector mounted result ->" $CAP
done

# --- June Local: apply staged app patches ----------------------------------
# Back up the live APK, copy the staged one over the decrypted EncFS view,
# verify, and record the result in a world-readable log.
apply_staged_apk() {
   stage="$1"
   live="$2"
   label="$3"
   log="/data/june/logs/${label}_patch.log"
   /system/bin/busybox mkdir -p /data/june/logs
   if [ ! -f "$live" ]; then
      logi "june-local: $live not found; leaving collector read-write"
      echo "failed: live apk not found" > "$log"
   elif /system/bin/busybox cmp -s "$stage" "$live"; then
      logi "june-local: $label patch already applied"
      echo "already-applied" > "$log"
   else
      cp -f "$live" "/data/june/${label}_stock_backup.apk" 2>/dev/null
      if cp -f "$stage" "$live" && /system/bin/busybox cmp -s "$stage" "$live"; then
         sync
         logi "june-local: $label patch applied"
         echo "applied: $(/system/bin/busybox sha256sum "$live" | /system/bin/busybox awk '{print $1}')" > "$log"
         # A /data staging copy is only needed once: drop it so later boots go
         # back to the stock read-only mount. The /system copy stays in place
         # and is re-applied after a factory reset.
         case "$stage" in
            /data/june/*) rm -f "$stage" ;;
         esac
      else
         logi "june-local: $label patch FAILED; restoring stock apk"
         echo "failed: copy/verify failed" > "$log"
         cp -f "/data/june/${label}_stock_backup.apk" "$live" 2>/dev/null
      fi
   fi
   /system/bin/busybox chmod 0644 "$log" 2>/dev/null
}

if [ -n "$JCM_STAGE" ]; then
   apply_staged_apk "$JCM_STAGE" /system/priv-app/JuneCloudMessaging/JuneCloudMessaging.apk jcm
fi
if [ -n "$REMOTES_STAGE" ]; then
   apply_staged_apk "$REMOTES_STAGE" /system/priv-app/Remotes/Remotes.apk remotes
fi
if [ -n "$MEDIACAPTURER_STAGE" ]; then
   apply_staged_apk "$MEDIACAPTURER_STAGE" /system/priv-app/MediaCapturer/MediaCapturer.apk mediacapturer
fi
if [ -n "$CHEF_STAGE" ]; then
   apply_staged_apk "$CHEF_STAGE" /system/priv-app/Chef/Chef.apk chef
fi

# --- June Local: mDNS hostname + content mirror ----------------------------
# Android's NsdService advertises <net.hostname>.local; the installer writes
# the chosen name (without the .local suffix) to /system/etc/june_hostname.
if [ -f /system/etc/june_hostname ]; then
   HN=`cat /system/etc/june_hostname 2>/dev/null`
   case "$HN" in
      *.local) HN=${HN%.local} ;;
   esac
   if [ -n "$HN" ]; then
      setprop net.hostname "$HN"
      logi "june-local: net.hostname set to $HN"
   fi
fi

# june-local serves the presets catalog and bundles from
# capture/upstream-content, relative to its working directory (/).
if [ -d /data/june/upstream-content ]; then
   /system/bin/busybox mkdir -p /capture
   if [ ! -e /capture/upstream-content ]; then
      /system/bin/busybox ln -s /data/june/upstream-content /capture/upstream-content
   fi
fi

# --- June Local: keep the server logs readable -----------------------------
# june-local creates capture.jsonl / june-local.log as 0600 root; the adb
# shell cannot read them.  A tiny root-side loop keeps them world-readable so
# captures can be pulled with plain adb (no root, no UMS boot).
(
   while :; do
      /system/bin/busybox chmod 0644 \
         /data/june/logs/capture.jsonl \
         /data/june/logs/june-local.log \
         /data/june/logs/jcm_patch.log \
         /data/june/logs/remotes_patch.log \
         /data/june/logs/mediacapturer_patch.log 2>/dev/null
      sleep 5
   done
) &

setprop ro.june_encfs 1
